# Loaded via `import "dotenv/config"` in prisma.config.ts (Prisma 7 no longer auto-loads .env)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public"

# Used by docker-compose.yml to provision the postgres container
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DBNAME

REDIS_PASSWORD=redis
REDIS_PASSWORD=PASSWORD
REDIS_URL="redis://:PASSWORD@HOST:6380"
