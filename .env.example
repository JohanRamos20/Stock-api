# Loaded via `import "dotenv/config"` in prisma.config.ts (Prisma 7 no longer auto-loads .env)
DATABASE_URL="postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@localhost:5432/${POSTGRES_DB:-stock_api}?schema=public"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stock_api
REDIS_PASSWORD=redis
REDIS_URL="redis://:${REDIS_PASSWORD:-redis}@localhost:6380"

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:5173

# Used only by `npx prisma db seed` (prisma/seed.ts) to bootstrap the first ADMIN
# account when the database has none yet. Ignored (skipped) once an ADMIN exists.
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_SIAPP=0000000
INITIAL_ADMIN_SECTOR=ADMINISTRATIVE