generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum Sector {
  ACADEMICS
  ADMINISTRATIVE
}

enum RequestStatus {
  PENDING
  SEPARATED
  COMPLETED
  CANCELED
}

enum MaterialCategory {
  FERRAMENTA
  EPI
  CONSUMIVEL
}

enum UnitType {
  UNITY
  BOX
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  siapp    String @unique
  password String
  role     Role
  sector   Sector

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  requests               Request[] @relation("RequestRequester")
  completedRequests      Request[] @relation("RequestAdmin")
  requestsCreatedAsAdmin Request[] @relation("RequestCreatedByAdmin")

  @@map("users")
}

model Request {
  id                  String        @id @default(uuid())
  userId              String        @map("user_id")
  user                User          @relation("RequestRequester", fields: [userId], references: [id])
  adminId             String?       @map("admin_id")
  admin               User?         @relation("RequestAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  adminName           String?       @map("admin_name")
  createdByAdminId    String?       @map("created_by_admin_id")
  createdByAdmin      User?         @relation("RequestCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByAdminName  String?       @map("created_by_admin_name")
  prazo               DateTime
  status              RequestStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  materials RequestMaterial[]

  @@map("requests")
}

model Material {
  id       String           @id @default(uuid())
  name     String
  category MaterialCategory
  location String
  amount   Int
  unitType UnitType         @map("unit_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  requests RequestMaterial[]

  @@map("materials")
}

model RequestMaterial {
  id         String @id @default(uuid())
  requestId  String @map("request_id")
  materialId String @map("material_id")
  quantity   Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  request  Request  @relation(fields: [requestId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@unique([requestId, materialId])
  @@map("request_materials")
}
